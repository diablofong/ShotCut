# ShotCut 自建版環境變數
# 使用方式：cp .env.selfhosted.example .env，填入實際值後執行：
#   docker compose -f docker-compose.selfhosted.yml up

# ── 必填 ───────────────────────────────────────────────────────────

# 應用程式金鑰（執行 openssl rand -hex 32 產生）
SECRET_KEY=change-me-use-openssl-rand-hex-32

# MariaDB 密碼（同時作為資料庫連線密碼）
DB_PASSWORD=change-me-db-password

# MinIO / S3 存取金鑰（同時設定為 MinIO 管理帳號）
# S3_SECRET_ACCESS_KEY 長度 >= 8 字元（MinIO 要求）
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin

# ── 選填 ───────────────────────────────────────────────────────────

# 儲存桶名稱（預設 shotcut）
S3_BUCKET_NAME=shotcut

# 對外服務埠（預設 8000）
APP_PORT=8000

# 管理員帳號（首次啟動自動建立）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin1234

# 功能開關（雲端版預設關閉）
ENABLE_CLIPS=false
ENABLE_HIGHLIGHTS=false
ENABLE_SHARING=false

# 允許的 CORS 來源
CORS_ORIGINS=http://localhost:8000
