# MariaDB（生產環境請使用強密碼，至少 16 字符含大小寫數字特殊符號）
MYSQL_ROOT_PASSWORD=Use-Strong-Password-Min-16-Chars-With-Special!Symbols@2024
MYSQL_DATABASE=shotcut
MYSQL_USER=shotcut
MYSQL_PASSWORD=Use-Strong-Password-Min-16-Chars-With-Special!Symbols@2024

# 後端
DATABASE_URL=mysql+aiomysql://shotcut:shotcut_pass@db:3306/shotcut

# SECRET_KEY（必須至少 32 字符，不可使用預設值：change-me, test, secret, password, default）
# 生成強密鑰指令：python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me-to-a-random-string-at-least-32-characters-long-use-generator-above

# 管理員帳號（生產環境請修改，密碼至少 12 字符含大小寫數字特殊符號）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Change-Me-To-Secure-Password-Min-12-Chars!@2024
JWT_ACCESS_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_DAYS=7
UPLOAD_DIR=/app/uploads
CLIP_DIR=/app/clips
HIGHLIGHT_DIR=/app/highlights

# 生產環境標誌
# - false：直接以 HTTP 存取（本機開發、無反向代理）
# - true：強制啟用 Cookie Secure Flag
# 注意：透過 nginx/Caddy 等反向代理做 SSL 終止時，系統會自動偵測 X-Forwarded-Proto: https
#       並自動啟用 Secure Flag，無需手動設為 true
#       只有在直接以 HTTPS 終止（不經過反向代理）時才需要設為 true
IS_PRODUCTION=false

# CORS 允許的來源（逗號分隔）
CORS_ORIGINS=http://localhost:5173,http://localhost:8000

# 上傳檔案大小上限（MB）
MAX_UPLOAD_SIZE_MB=2048

# 連接埠
APP_PORT=8000
