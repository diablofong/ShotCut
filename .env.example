# MariaDB
MYSQL_ROOT_PASSWORD=shotcut_root_pass
MYSQL_DATABASE=shotcut
MYSQL_USER=shotcut
MYSQL_PASSWORD=shotcut_pass

# 後端
DATABASE_URL=mysql+asyncmy://shotcut:shotcut_pass@db:3306/shotcut
SECRET_KEY=change-me-to-a-random-string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-secure-password
JWT_ACCESS_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_DAYS=7
UPLOAD_DIR=/app/uploads
CLIP_DIR=/app/clips
HIGHLIGHT_DIR=/app/highlights

# 生產環境標誌（生產環境設為 true 以啟用安全措施如 Cookie Secure Flag）
IS_PRODUCTION=false

# CORS 允許的來源（逗號分隔）
CORS_ORIGINS=http://localhost:5173,http://localhost:8000

# 上傳檔案大小上限（MB）
MAX_UPLOAD_SIZE_MB=2048

# 連接埠
APP_PORT=8000
