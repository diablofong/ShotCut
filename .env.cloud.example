# ShotCut 雲端版環境變數
# 使用方式：cp .env.cloud.example .env，填入實際值後執行：
#   docker compose -f docker-compose.cloud.yml up

# ── 必填 ───────────────────────────────────────────────────────────

# 資料庫連線（MySQL-compatible，例如 MariaDB / PlanetScale / RDS）
DATABASE_URL=mysql+aiomysql://user:password@host:3306/shotcut

# 應用程式金鑰（執行 openssl rand -hex 32 產生）
SECRET_KEY=change-me-use-openssl-rand-hex-32

# S3-compatible 儲存設定
# Cloudflare R2: S3_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
# AWS S3:        S3_ENDPOINT_URL 留空（使用預設 endpoint）
S3_ACCESS_KEY_ID=your-access-key-id
S3_SECRET_ACCESS_KEY=your-secret-access-key
S3_BUCKET_NAME=shotcut-videos
S3_ENDPOINT_URL=https://your-account-id.r2.cloudflarestorage.com

# ── 選填 ───────────────────────────────────────────────────────────

# 對外服務埠（預設 8000）
APP_PORT=8000

# 生產環境（啟用 HSTS 等安全標頭）
IS_PRODUCTION=true

# 允許的 CORS 來源（逗號分隔）
CORS_ORIGINS=https://your-domain.com

# 管理員帳號（首次啟動自動建立）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin1234

# 功能開關
ENABLE_CLIPS=false
ENABLE_HIGHLIGHTS=false
ENABLE_SHARING=false
