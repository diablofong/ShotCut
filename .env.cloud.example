# ShotCut 雲端版環境設定範本
# 複製此檔為 .env 並填入實際值

# ── 資料庫 ────────────────────────────────────────────────
DATABASE_URL=mysql+aiomysql://shotcut:CHANGE_ME@db:3306/shotcut
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT
MYSQL_DATABASE=shotcut
MYSQL_USER=shotcut
MYSQL_PASSWORD=CHANGE_ME

# ── 安全性 ────────────────────────────────────────────────
# 生成方式：python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=CHANGE_ME_AT_LEAST_32_CHARS

# ── 管理員帳號 ────────────────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD

# ── 儲存後端（雲端用 r2，本地開發用 local） ────────────────
STORAGE_BACKEND=r2

# Cloudflare R2（STORAGE_BACKEND=r2 時必填）
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=shotcut-videos
R2_ENDPOINT_URL=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com

# 本地開發用 MinIO（docker-compose.cloud.yml）
# R2_ENDPOINT_URL=http://minio:9000
# R2_ACCESS_KEY_ID=minioadmin
# R2_SECRET_ACCESS_KEY=minioadmin

# ── 功能開關（雲端版關閉不需要的功能） ───────────────────
ENABLE_CLIPS=false
ENABLE_HIGHLIGHTS=false
ENABLE_SHARING=false

# ── CORS ─────────────────────────────────────────────────
# 填入 Cloudflare Pages 網址
CORS_ORIGINS=https://YOUR_APP.pages.dev

# ── 其他 ─────────────────────────────────────────────────
IS_PRODUCTION=true
APP_PORT=8000
